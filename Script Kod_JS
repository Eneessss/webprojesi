/* Seçili ülke ve favoriler. Favoriler tarayıcıda (localStorage) saklanır. */
let seciliId = "tr";
let pinEls = {}; // ülke id -> etiket elemanı
let favoriler = [];
try { favoriler = JSON.parse(localStorage.getItem("favoriler")) || []; } catch (e) { favoriler = []; }

/* ---------- 2) YARDIMCILAR ---------- */
const $ = (id) => document.getElementById(id);

// Resim etiketi: açılmazsa kendini siler, arkadaki renk geçişi kalır
const resim = (src, alt) =>
  `<img src="${src}" alt="${alt}" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">`;

const seciliUlke = () => ulkeler.find((u) => u.id === seciliId);

/* ---------- 3) EKRANA ÇİZEN FONKSİYONLAR ---------- */

// Dünyanın üstündeki ülke etiketleri (konumlarını aşağıdaki döngü her karede günceller)
function kureyiCiz() {
  $("pinler").innerHTML = ulkeler.map((u) =>
    `<button class="pin gizli ${u.id === seciliId ? "aktif" : ""}" data-id="${u.id}">${resim(u.bayrak, "")}${u.ad}</button>`
  ).join("");
  pinEls = {};
  document.querySelectorAll("#pinler .pin").forEach((el) => (pinEls[el.dataset.id] = el));
}

// Sağdaki ülke paneli
function paneliCiz() {
  const u = seciliUlke();
  const ekli = favoriler.includes(u.id);
  $("panel").innerHTML = `
    <div class="gorsel foto">${resim(u.foto, u.ad)}
      <button class="kalp ${ekli ? "ekli" : ""}" data-fav="${u.id}" aria-label="Favori">${ekli ? "♥" : "♡"}</button>
    </div>
    <div class="ulke-baslik">${resim(u.bayrak, u.ad + " bayrağı")}
      <div><h3>${u.ad}</h3><small>${u.slogan}</small></div></div>
    <div class="bilgi">
      <div><span>🏛</span><p><small>Başkent</small>${u.baskent}</p></div>
      <div><span>💬</span><p><small>Resmi dil</small>${u.dil}</p></div>
      <div><span>💰</span><p><small>Para birimi</small>${u.para}</p></div>
      <div><span>🌐</span><p><small>Kıta</small>${u.kita}</p></div>
    </div>
    <h4>⭐ Gezilecek Yerler</h4>
    <div class="yerler">${u.yerler.map((y) =>
      `<div><div class="gorsel">${resim(y.foto, y.ad)}</div><small>${y.ad}</small></div>`).join("")}</div>
    <button class="fav-btn ${ekli ? "ekli" : ""}" data-fav="${u.id}">
      ${ekli ? "♥ Favorilerimden Çıkar" : "♡ Favorilerime Ekle"}</button>`;
}

// Alttaki popüler ülkeler
function kartlariCiz() {
  $("kartlar").innerHTML = ulkeler.map((u) => `
    <button class="kart ${u.id === seciliId ? "aktif" : ""}" data-id="${u.id}">
      <div class="gorsel">${resim(u.foto, u.ad)}</div>
      <div class="kart-alt">
        <div class="kart-ust">${resim(u.bayrak, "")}<strong>${u.ad}</strong><span class="ok">➜</span></div>
        <small>${u.kisa}</small>
      </div></button>`).join("");
}

// Favoriler listesi
function favleriCiz() {
  $("favListe").innerHTML = favoriler.length
    ? favoriler.map((id) => {
        const u = ulkeler.find((x) => x.id === id);
        return `<li>${resim(u.bayrak, "")}${u.ad}</li>`;
      }).join("")
    : `<li class="bos">Henüz favori yok. Bir ülke seçip kalbe bas.</li>`;
}

function hepsiniCiz() { kureyiCiz(); paneliCiz(); kartlariCiz(); favleriCiz(); }

/* ---------- 4) OLAYLAR ---------- */
// Tek dinleyici: pin, kart veya favori butonuna tıklanınca çalışır (event delegation)
document.addEventListener("click", (e) => {
  const secim = e.target.closest("[data-id]");
  if (secim) { seciliId = secim.dataset.id; hepsiniCiz(); ulkeyeDon(seciliId); return; }

  const fav = e.target.closest("[data-fav]");
  if (fav) {
    const id = fav.dataset.fav;
    favoriler = favoriler.includes(id) ? favoriler.filter((f) => f !== id) : [...favoriler, id];
    try { localStorage.setItem("favoriler", JSON.stringify(favoriler)); } catch (e) {}
    hepsiniCiz();
  }
});

// Arama kutusu: yazdıkça ülke adını arar ve bulduğunu seçer
$("ara").addEventListener("input", (e) => {
  const aranan = e.target.value.trim().toLocaleLowerCase("tr");
  if (!aranan) return;
  const bulunan = ulkeler.find((u) => u.ad.toLocaleLowerCase("tr").startsWith(aranan));
  if (bulunan) { seciliId = bulunan.id; hepsiniCiz(); ulkeyeDon(seciliId); }
});

/* ---------- DÖNEN DÜNYA ----------
   Hiçbir dış kütüphane kullanmadan, <canvas> üzerine küreyi kendimiz çiziyoruz.
   Mantık: ekrandaki her piksel için "bu piksel kürenin hangi enlem/boylamına denk geliyor?"
   hesaplanır ve dünya haritasından o noktanın rengi alınır (ortografik izdüşüm).
   - Fareyle (veya parmakla) sürükleyince küre döner.
   - Bir ülkeye tıklayınca küre o ülkeyi öne getirecek şekilde döner.
   - Ülke etiketleri enlem/boylamdan hesaplanır, arka tarafta kalınca gizlenir.
   - 4 saniye dokunulmazsa küre kendi kendine yavaşça döner. */
const KONUM = { tr:[39,35], it:[42.5,12.5], jp:[36,138], eg:[26,30], br:[-10,-52] }; // [enlem, boylam]
const D2R = Math.PI / 180;
const BOYUT = 440;                         // çizim çözünürlüğü (piksel)
const DOKU_W = 1024, DOKU_H = 512;         // harita dokusu boyutu
let rx = 0.5, ry = -(35 + 90) * D2R;       // başlangıçta Türkiye önde
let hedef = null, surukleme = false, onceki = {x:0, y:0}, sonEtkilesim = Date.now();
let dokuVeri = null, cizCtx = null, resimVeri = null, resim32 = null;
let pikseller = null;                      // küre içindeki piksellerin hazır hesapları

// Enlem/boylamı küre üzerindeki 3B noktaya çevirir
function noktaHesapla(enlem, boylam) {
  const phi = (90 - enlem) * D2R, theta = (boylam + 180) * D2R;
  return { x: -Math.sin(phi) * Math.cos(theta), y: Math.cos(phi), z: Math.sin(phi) * Math.sin(theta) };
}

// Seçilen ülkeyi öne getirmek için hedef dönüş açısını ayarlar
function ulkeyeDon(id) {
  const k = KONUM[id]; if (!k) return;
  hedef = { ry: -(k[1] + 90) * D2R, rx: k[0] * D2R * 0.8 };
}

// Harita dokusu yoksa kullanılacak yedek: okyanus mavisi + enlem/boylam çizgileri
function yedekDokuCiz() {
  const c = document.createElement("canvas"); c.width = DOKU_W; c.height = DOKU_H;
  const g = c.getContext("2d");
  g.fillStyle = "#1c5d96"; g.fillRect(0, 0, DOKU_W, DOKU_H);
  g.strokeStyle = "rgba(255,255,255,.35)"; g.lineWidth = 2;
  for (let i = 0; i <= 24; i++) { g.beginPath(); g.moveTo(i * DOKU_W / 24, 0); g.lineTo(i * DOKU_W / 24, DOKU_H); g.stroke(); }
  for (let i = 0; i <= 12; i++) { g.beginPath(); g.moveTo(0, i * DOKU_H / 12); g.lineTo(DOKU_W, i * DOKU_H / 12); g.stroke(); }
  dokuVeri = g.getImageData(0, 0, DOKU_W, DOKU_H).data;
}

// NASA Blue Marble haritasını (Wikimedia Commons) yükler. Olmazsa yedek doku kalır.
function haritaYukle() {
  const adaylar = [
    "https://commons.wikimedia.org/wiki/Special:FilePath/" + encodeURIComponent("Land ocean ice 2048.jpg") + "?width=2048",
    "https://commons.wikimedia.org/wiki/Special:FilePath/" + encodeURIComponent("Whole world - land and oceans.jpg") + "?width=2048"
  ];
  (function dene(i) {
    if (i >= adaylar.length) return;
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      try {
        const c = document.createElement("canvas"); c.width = DOKU_W; c.height = DOKU_H;
        const g = c.getContext("2d");
        g.drawImage(img, 0, 0, DOKU_W, DOKU_H);
        dokuVeri = g.getImageData(0, 0, DOKU_W, DOKU_H).data;   // izin yoksa hata verir
      } catch (e) { dene(i + 1); }
    };
    img.onerror = () => dene(i + 1);
    img.src = adaylar[i];
  })(0);
}

// Küre içindeki her piksel için ekran koordinatı ve ışık değerini bir kez hesapla
function pikselleriHazirla() {
  const n = BOYUT, liste = [];
  for (let py = 0; py < n; py++) {
    for (let px = 0; px < n; px++) {
      const x = (px + 0.5) / n * 2 - 1, y = 1 - (py + 0.5) / n * 2, d = x * x + y * y;
      if (d >= 1) continue;
      const z = Math.sqrt(1 - d);
      const isik = Math.max(0, x * -0.4 + y * 0.35 + z * 0.85);   // ışık sol üstten
      const kenar = 1 - Math.pow(1 - z, 3) * 0.5;                    // kenarlarda hafif kararma
      liste.push({ i: py * n + px, x, y, z, s: (0.4 + 0.75 * isik) * kenar });
    }
  }
  pikseller = liste;
}

// Küreyi mevcut dönüş açılarına göre çizer
function kureyiBoya() {
  const n = BOYUT, sx = Math.sin(rx), cx = Math.cos(rx), sy = Math.sin(ry), cy = Math.cos(ry);
  resim32.fill(0);
  for (let k = 0; k < pikseller.length; k++) {
    const p = pikseller[k];
    // ekran noktasını dönüşün tersiyle kürenin kendi koordinatına çevir
    const y1 = p.y * cx + p.z * sx, z1 = -p.y * sx + p.z * cx;
    const x2 = p.x * cy - z1 * sy, z2 = p.x * sy + z1 * cy;
    let theta = Math.atan2(z2, -x2); if (theta < 0) theta += 2 * Math.PI;
    const u = theta / (2 * Math.PI), v = Math.acos(Math.max(-1, Math.min(1, y1))) / Math.PI;
    const t = (((v * DOKU_H) | 0) * DOKU_W + ((u * DOKU_W) | 0) % DOKU_W) * 4;
    const r = Math.min(255, dokuVeri[t] * p.s), g = Math.min(255, dokuVeri[t + 1] * p.s), b = Math.min(255, dokuVeri[t + 2] * p.s);
    resim32[p.i] = (255 << 24) | (b << 16) | (g << 8) | r;
  }
  cizCtx.putImageData(resimVeri, 0, 0);
}

// Etiketleri dünyanın üstündeki doğru yere koyar, arkada kalanları gizler
function etiketleriKonumla() {
  const w = $("kure").clientWidth, sx = Math.sin(rx), cx = Math.cos(rx), sy = Math.sin(ry), cy = Math.cos(ry);
  for (const id in KONUM) {
    const el = pinEls[id]; if (!el) continue;
    const p = noktaHesapla(KONUM[id][0], KONUM[id][1]);
    const x1 = p.x * cy + p.z * sy, z1 = -p.x * sy + p.z * cy;       // önce yatay dönüş
    const y2 = p.y * cx - z1 * sx, z2 = p.y * sx + z1 * cx;          // sonra eğim
    el.style.left = (x1 * 0.5 + 0.5) * w + "px";
    el.style.top = (-y2 * 0.5 + 0.5) * w + "px";
    el.classList.toggle("gizli", z2 < 0.15);                         // arka yüzdeki ülkeleri gizle
  }
}

// Her karede çalışır
function dongu() {
  requestAnimationFrame(dongu);
  if (hedef && !surukleme) {                       // seçilen ülkeye yumuşak geçiş
    let d = hedef.ry - ry; d = Math.atan2(Math.sin(d), Math.cos(d));
    ry += d * 0.08; rx += (hedef.rx - rx) * 0.08;
    if (Math.abs(d) < 0.002 && Math.abs(hedef.rx - rx) < 0.002) hedef = null;
  } else if (!surukleme && Date.now() - sonEtkilesim > 4000) {
    ry += 0.002;                                   // boşta kalınca yavaş dön
  }
  kureyiBoya();
  etiketleriKonumla();
}

function dunyayiBaslat() {
  const cv = $("kureCanvas");
  cv.width = BOYUT; cv.height = BOYUT;
  cizCtx = cv.getContext("2d");
  resimVeri = cizCtx.createImageData(BOYUT, BOYUT);
  resim32 = new Uint32Array(resimVeri.data.buffer);
  yedekDokuCiz();
  haritaYukle();
  pikselleriHazirla();

  // Sürükleyerek döndürme (fare ve dokunmatik)
  cv.addEventListener("pointerdown", (e) => { surukleme = true; hedef = null; onceki = {x:e.clientX, y:e.clientY}; cv.setPointerCapture(e.pointerId); });
  cv.addEventListener("pointermove", (e) => {
    if (!surukleme) return;
    ry += (e.clientX - onceki.x) * 0.006;
    rx = Math.max(-1.2, Math.min(1.2, rx + (e.clientY - onceki.y) * 0.006));
    onceki = {x:e.clientX, y:e.clientY};
    sonEtkilesim = Date.now();
  });
  const birak = () => { surukleme = false; sonEtkilesim = Date.now(); };
  cv.addEventListener("pointerup", birak);
  cv.addEventListener("pointercancel", birak);

  dongu();
}

// Başlangıç
hepsiniCiz();
try { dunyayiBaslat(); } catch (hata) { console.error("Dünya başlatılamadı:", hata); } // dünya bozulsa bile sayfanın geri kalanı çalışsın
