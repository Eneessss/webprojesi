document.addEventListener("click", (e) => {
  const pin = e.target.closest(".pin");
  const kart = e.target.closest(".kart");
  const favBtn = e.target.closest("[data-fav]");

  if (pin || kart) {
    seciliId = (pin || kart).dataset.id;
    hepsiniCiz();
  }
  if (favBtn) {
    const id = favBtn.dataset.fav;
    if (favoriler.includes(id)) {
      favoriler = favoriler.filter(x => x !== id);
    } else {
      favoriler.push(id);
    }
    try { localStorage.setItem("favoriler", JSON.stringify(favoriler)); } catch(err){}
    hepsiniCiz();
  }
});

// Canvas Küre Animasyonu ve Sürükleme Mantığı
const canvas = $("kureCanvas");
const ctx = canvas.getContext("2d");
let aciX = 0.3, aciY = 0.5, surukleniyor = false, basX = 0, basY = 0;

function boyutlandir() {
  const r = canvas.getBoundingClientRect();
  canvas.width = r.width * window.devicePixelRatio;
  canvas.height = r.height * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
}
window.addEventListener("resize", boyutlandir);
boyutlandir();

canvas.addEventListener("pointerdown", (e) => {
  surukleniyor = true;
  basX = e.clientX;
  basY = e.clientY;
  canvas.setPointerCapture(e.pointerId);
});

canvas.addEventListener("pointermove", (e) => {
  if (!surukleniyor) return;
  const dx = e.clientX - basX;
  const dy = e.clientY - basY;
  aciY += dx * 0.008;
  aciX = Math.max(-1.2, Math.min(1.2, aciX - dy * 0.008));
  basX = e.clientX;
  basY = e.clientY;
});

canvas.addEventListener("pointerup", (e) => {
  surukleniyor = false;
  try { canvas.releasePointerCapture(e.pointerId); } catch(err){}
});

function ciz() {
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  const merkezX = w / 2;
  const merkezY = h / 2;
  const yaricap = w * 0.42;

  ctx.clearRect(0, 0, w, h);

  // Küre arka plan tabanı
  const grad = ctx.createRadialGradient(merkezX - yaricap*0.3, merkezY - yaricap*0.3, yaricap*0.1, merkezX, merkezY, yaricap);
  grad.addColorStop(0, "#4aa3d9");
  grad.addColorStop(0.45, "#1d5f9c");
  grad.addColorStop(1, "#06152b");
  
  ctx.save();
  ctx.beginPath();
  ctx.arc(merkezX, merkezY, yaricap, 0, Math.PI * 2);
  ctx.fillStyle = grad;
  ctx.fill();
  ctx.clip();

  // Çizgi simülasyonu
  ctx.strokeStyle = "rgba(255,255,255,0.12)";
  ctx.lineWidth = 1.5;
  for (let i = -3; i <= 3; i++) {
    ctx.beginPath();
    ctx.arc(merkezX + i * 40 * Math.sin(aciY), merkezY, yaricap * 0.8, 0, Math.PI * 2);
    ctx.stroke();
  }

  ctx.restore();

  // Pin konumları hesaplama
  ulkeler.forEach((u) => {
    const el = pinEls[u.id];
    if (!el) return;

    const radB = (u.pin.x / 100) * Math.PI * 2 + aciY;
    const radE = (u.pin.y / 100) * Math.PI - Math.PI/2 + aciX;

    const x = merkezX + yaricap * Math.cos(radE) * Math.sin(radB);
    const y = merkezY + yaricap * Math.sin(radE);
    const gorunur = Math.cos(radB) > -0.2;

    if (gorunur) {
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.classList.remove("gizli");
    } else {
      el.classList.add("gizli");
    }
  });

  if (!surukleniyor) {
    aciY += 0.0015;
  }

  requestAnimationFrame(ciz);
}

// Uygulamayı Başlat
hepsiniCiz();
requestAnimationFrame(ciz);
