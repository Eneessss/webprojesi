   sayfa bozulmaz. Başka görsel istersen sadece dosya adını değiştir. */
const commons = (dosya) =>
  "https://commons.wikimedia.org/wiki/Special:FilePath/" + encodeURIComponent(dosya) + "?width=700";
/* ---------- İÇ GÖRSELLER (internet gerektirmez) ----------
   Bayraklar ve ülke/yer resimleri SVG olarak kodla çizilir; her zaman görünür ve telif sorunu yoktur.
   Gerçek fotoğraf eklemek istersen aşağıdaki veri listesinde "foto" alanına kendi resim yolunu yaz
   (örn. "resimler/turkiye.jpg"). Fotoğraf yüklenirse çizimin üstünü kaplar. */
const svgUri = (s) => "data:image/svg+xml;utf8," + encodeURIComponent(s);
const yildiz = (cx, cy, r) => Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + i * Math.PI / 5, k = i % 2 ? r * 0.4 : r;
  return (cx + k * Math.cos(a)).toFixed(1) + "," + (cy + k * Math.sin(a)).toFixed(1);
}).join(" ");
const BAYRAKLAR = {
  tr: `<rect width="90" height="60" fill="#e30a17"/><circle cx="34" cy="30" r="14" fill="#fff"/><circle cx="38.5" cy="30" r="11.2" fill="#e30a17"/><polygon points="${yildiz(50, 30, 7)}" fill="#fff"/>`,
  it: `<rect width="30" height="60" fill="#009246"/><rect x="30" width="30" height="60" fill="#fff"/><rect x="60" width="30" height="60" fill="#ce2b37"/>`,
  jp: `<rect width="90" height="60" fill="#fff"/><circle cx="45" cy="30" r="17" fill="#bc002d"/>`,
  eg: `<rect width="90" height="20" fill="#ce1126"/><rect y="20" width="90" height="20" fill="#fff"/><rect y="40" width="90" height="20" fill="#000"/><circle cx="45" cy="30" r="5" fill="#c09300"/>`,
  br: `<rect width="90" height="60" fill="#009c3b"/><polygon points="45,6 83,30 45,54 7,30" fill="#ffdf00"/><circle cx="45" cy="30" r="13" fill="#002776"/>`
};
const bayrak = (kod) => svgUri(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 60" preserveAspectRatio="xMidYMid slice">${BAYRAKLAR[kod]}</svg>`);

// Çizilmiş manzaralar (300x170)
const gok = (a, b) => `<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient></defs><rect width="300" height="170" fill="url(#g)"/>`;
const minare = (x, h) => `<rect x="${x - 4}" y="${135 - h}" width="8" height="${h}" fill="#e9d2b0"/><polygon points="${x - 5},${135 - h} ${x},${135 - h - 22} ${x + 5},${135 - h}" fill="#7d8aa0"/>`;
const SAHNE = {
  ayasofya: () => gok("#2f2f6e", "#f4a261") + `<circle cx="235" cy="45" r="16" fill="#ffe7b3" opacity=".85"/><rect y="135" width="300" height="35" fill="#1b3556"/><rect x="95" y="98" width="110" height="38" fill="#d9a36b"/><path d="M108 98a42 42 0 0 1 84 0z" fill="#c4875a"/><path d="M134 72a16 16 0 0 1 32 0z" fill="#b9774f"/>` + minare(70, 70) + minare(230, 70) + minare(88, 50) + minare(212, 50),
  balon: () => gok("#f6a5b9", "#ffd89b") + `<polygon points="0,170 60,95 120,170" fill="#b87a52"/><polygon points="70,170 140,80 210,170" fill="#a56a46"/><polygon points="170,170 235,100 300,170" fill="#b87a52"/>` + [[70, 45, "#e63946"], [150, 30, "#f4d35e"], [225, 55, "#3a86ff"]].map(([x, y, c]) => `<ellipse cx="${x}" cy="${y}" rx="17" ry="21" fill="${c}"/><rect x="${x - 4}" y="${y + 25}" width="8" height="6" fill="#5a3a22"/>`).join(""),
  travertan: () => gok("#6bb8e8", "#d8f0fb") + `<rect y="110" width="300" height="60" fill="#e9f7ff"/>` + [0, 1, 2, 3].map((i) => `<ellipse cx="150" cy="${112 + i * 15}" rx="${120 + i * 14}" ry="12" fill="#7fd0e6" stroke="#fff" stroke-width="4"/>`).join(""),
  kolezyum: () => gok("#5b4b8a", "#f7b267") + `<rect y="140" width="300" height="30" fill="#6b5a3a"/><path d="M40 140V80q110-40 220 0v60z" fill="#c9a26a"/>` + [0, 1, 2].map((r) => [...Array(7)].map((_, i) => `<rect x="${58 + i * 28}" y="${88 + r * 18}" width="12" height="12" rx="6" fill="#6b4a2a"/>`).join("")).join(""),
  venedik: () => gok("#7ec8e3", "#fde7c3") + `<rect y="120" width="300" height="50" fill="#2f78a8"/>` + [[10, 60, "#e9a07a"], [70, 80, "#f2cf8b"], [130, 55, "#d98c6c"], [190, 75, "#efc4a0"], [245, 55, "#e0a58a"]].map(([x, h, c]) => `<rect x="${x}" y="${120 - h}" width="48" height="${h}" fill="${c}"/><rect x="${x + 8}" y="${130 - h}" width="8" height="12" fill="#6b3a2a"/><rect x="${x + 30}" y="${130 - h}" width="8" height="12" fill="#6b3a2a"/>`).join("") + `<path d="M110 150q40 14 80 0l-8-10h-64z" fill="#222"/>`,
  pisa: () => gok("#8ed1f5", "#e9f7ff") + `<rect y="135" width="300" height="35" fill="#5fae5c"/><g transform="rotate(6 150 136)">` + [0, 1, 2, 3, 4, 5].map((i) => `<rect x="132" y="${40 + i * 16}" width="36" height="14" fill="${i % 2 ? "#f1ece0" : "#fffaf0"}" stroke="#cfc7b4"/>`).join("") + `</g>`,
  fuji: () => gok("#7fb7e6", "#fbd1df") + `<polygon points="40,150 150,45 260,150" fill="#4a6fa5"/><polygon points="122,73 150,45 178,73 165,67 150,78 135,67" fill="#fff"/><rect y="148" width="300" height="22" fill="#2d5f8a"/>` + [[40, 120], [70, 105], [240, 115], [265, 100], [220, 95]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="16" fill="#f7a6c4"/><circle cx="${x + 10}" cy="${y + 8}" r="11" fill="#f4bfd4"/>`).join(""),
