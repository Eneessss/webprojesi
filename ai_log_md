function kureyiCiz() {
  $("pinler").innerHTML = ulkeler.map((u) =>
    `<button class="pin gizli ${u.id === seciliId ? "aktif" : ""}" data-id="${u.id}">${resim(u.bayrak, "")}${u.ad}</button>`
