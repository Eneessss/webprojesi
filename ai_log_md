  color: var(--turkuaz);
  font-size: 0.9rem;
}

.kartlar {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
}

.kart {
  background: var(--panel);
  border: 1px solid var(--cizgi);
  border-radius: 12px;
  overflow: hidden;
  text-align: left;
  transition: border-color 0.2s;
}

.kart:hover,
.kart.aktif {
  border-color: var(--turkuaz);
}

.kart .gorsel {
  height: 110px;
}

.kart-alt {
  padding: 12px;
}

.kart-ust {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}

.kart-ust img {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
}

.kart-ust strong {
  flex: 1;
}

.ok {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--turkuaz);
  color: var(--turkuaz);
  display: grid;
  place-items: center;
  font-size: 0.8rem;
}

.kart small {
  color: #c3d1e2;
}

/* ===== FAVORİLER ===== */
.favler {
  padding: 0 4% 50px;
}

.favler ul {
  list-style: none;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.favler li {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--panel);
  border: 1px solid var(--cizgi);
  border-radius: 22px;
  padding: 6px 16px 6px 8px;
}

.favler li img {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  object-fit: cover;
}

.favler .bos {
  color: var(--soluk);
  padding: 6px 16px;
}

/* ===== MOBİL / TABLET ===== */
@media (max-width: 1200px) {
  .hero { grid-template-columns: 1fr 1fr; }
  .panel { grid-column: 1 / -1; }
  .kartlar { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 760px) {
  .ust { flex-wrap: wrap; gap: 12px; }
  nav { order: 3; width: 100%; gap: 18px; }
  #ara { width: 100%; flex: 1; }
  .hero { grid-template-columns: 1fr; }
  .kartlar { grid-template-columns: repeat(2, 1fr); }
}

