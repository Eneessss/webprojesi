const $ = (id) => document.getElementById(id);

// Resim etiketi: liste verilirse sırayla dener, hiçbiri açılmazsa kendini siler (arkadaki çizim görünür)
function sonraki(img) {
  const liste = img.dataset.liste.split("|"), i = Number(img.dataset.i) + 1;
  if (i < liste.length) { img.dataset.i = i; img.src = liste[i]; } else img.remove();
}
const resim = (src, alt) => {
  const liste = Array.isArray(src) ? src : [src];
  return `<img src="${liste[0]}" data-liste="${liste.join("|")}" data-i="0" alt="${alt}" loading="lazy" referrerpolicy="no-referrer" onerror="sonraki(this)">`;
};

